<quiz>

  <!-- 1. Opción múltiple (una sola correcta) -->
  <question type="multichoice">
    <name>
      <text>Capital de México</text>
    </name>
    <questiontext format="html">
      <text><![CDATA[<p>¿Cuál es la capital de México?</p>]]></text>
    </questiontext>
    <generalfeedback format="html">
      <text><![CDATA[<p>La capital de México es Ciudad de México, también conocida como CDMX.</p>]]></text>
    </generalfeedback>
    <defaultgrade>1.0000000</defaultgrade>
    <penalty>0.3333333</penalty>
    <hidden>0</hidden>
    <idnumber></idnumber>
    <single>true</single>
    <shuffleanswers>true</shuffleanswers>
    <answernumbering>abc</answernumbering>
    <correctfeedback format="html">
      <text><![CDATA[<p>¡Correcto! Ciudad de México es la capital del país.</p>]]></text>
    </correctfeedback>
    <partiallycorrectfeedback format="html">
      <text><![CDATA[<p>Algunas respuestas son correctas, revisa de nuevo la capital oficial.</p>]]></text>
    </partiallycorrectfeedback>
    <incorrectfeedback format="html">
      <text><![CDATA[<p>No es correcto. La capital de México es Ciudad de México.</p>]]></text>
    </incorrectfeedback>
    <answer fraction="100" format="html">
      <text><![CDATA[Ciudad de México]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Correcto, Ciudad de México es la capital.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Guadalajara]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrecto, Guadalajara es una ciudad importante, pero no la capital.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Monterrey]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrecto, Monterrey es una ciudad industrial, pero no la capital.</p>]]></text>
      </feedback>
    </answer>
    <answer fraction="0" format="html">
      <text><![CDATA[Puebla]]></text>
      <feedback format="html">
        <text><![CDATA[<p>Incorrecto, Puebla es una ciudad histórica, pero no la capital.</p>]]></text>
      </feedback>
    </answer>
  </question>

